{
  "name": "@forgefence/proxy",
  "version": "0.1.0",
  "description": "ForgeFence MCP session IFC proxy",
  "type": "module",
  "bin": {
    "forgefence": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts --config ../../forgefence.config.yaml",
    "demo": "tsx src/demo-runner.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
